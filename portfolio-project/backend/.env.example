# Port the API server listens on
PORT=4000

# Comma-separated list of origins allowed to call this API
CLIENT_ORIGIN=http://localhost:5173

# --- Optional: only needed if you want the contact form to send real emails ---
# SMTP credentials (e.g. Gmail App Password, SendGrid, Mailgun, etc.)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
CONTACT_TO_EMAIL=shivanshur62@gmail.com

# If SMTP_* vars are left blank, submissions are still validated and saved
# to backend/data/messages.json so nothing is lost during local development.
